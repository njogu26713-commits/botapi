# ============================================================
# FireboxTechs WhatsApp Assistant — Environment Variables
# Copy this file to .env for local development.
# Set these as Railway environment variables for production.
# ============================================================

# --- Server (required) ---
PORT=5000
NODE_ENV=production

# --- MongoDB (required) ---
# Provide a MongoDB Atlas (or other hosted) connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fireboxtechs

# --- AI Provider (pick one or both) ---
# "auto" uses Groq if GROQ_API_KEY is set, otherwise falls back to OpenAI.
AI_PROVIDER=auto

# Groq (recommended — fast & free tier available)
GROQ_API_KEY=
# Current production model; replaces the retired Llama 3.3 70B model.
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI (fallback or primary)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2048

# --- WhatsApp / Baileys ---
# Absolute path to the persistent session directory.
# On Railway, mount a Volume to this path so sessions survive redeploys.
SESSION_DIR=/app/sessions
BOT_NAME=FireboxTechs Assistant
# Optional public HTTPS image shown above AI text and buttons in one card.
AI_CARD_IMAGE_URL=

# Phone number for pairing-code auth (optional — leave blank to use QR code).
BOT_NUMBER=
USE_PAIRING_CODE=false

# --- Admin API ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# --- Optional integrations ---
# OpenWeatherMap
WEATHER_API_KEY=

# NewsAPI.org
NEWS_API_KEY=

# Google Custom Search
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Webhook forwarding
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=

# --- Feature flags ---
AI_ENABLED=true
MEDIA_DOWNLOAD_ENABLED=true
ANTISPAM_ENABLED=true
ANTISPAM_THRESHOLD=5
CONVERSATION_CONTEXT_WINDOW=20

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_AI_WINDOW_MS=60000
RATE_LIMIT_AI_MAX_REQUESTS=10

# --- Logging ---
LOG_LEVEL=info
